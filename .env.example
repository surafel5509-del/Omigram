# Supabase public client configuration.
# Use the project's publishable key (sb_publishable_...) for the Android client.
# Never put a Supabase secret/service-role key in this file or in the APK.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional: only enable this if the app actually uses Gemini later.
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY
